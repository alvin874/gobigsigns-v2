{%- doc -%}
  Key specs table for a wall-art product: size, material, frame,
  ready-to-hang hardware, and two spare rows.

  Each row names a metafield as "namespace.key". The row is dropped when
  that metafield is empty, and the whole block disappears when every row
  is empty, so a product with no specs filled in never shows a bare
  heading.

  Value handling by metafield type:
    list.*    joined with commas
    boolean   true shows the "included" wording, false drops the row
    anything  rendered as Shopify renders it, so rich text keeps markup

  A row can also fall back to a product option (for example "Size") when
  its metafield is empty, which covers products whose size lives in the
  variant options rather than in a metafield.
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
  assign product = closest.product
  assign rows = '1,2,3,4,5,6' | split: ','
-%}

{%- capture rows_markup -%}
  {%- for index in rows -%}
    {%- liquid
      assign label_key = 'row_' | append: index | append: '_label'
      assign field_key = 'row_' | append: index | append: '_field'
      assign option_key = 'row_' | append: index | append: '_option'

      assign row_label = block_settings[label_key]
      assign field_path = block_settings[field_key]
      assign option_name = block_settings[option_key]

      # An empty string stands in for "no metafield", so raw.type below
      # is simply nil rather than an error.
      assign raw = ''

      if row_label != blank and field_path != blank
        assign path_parts = field_path | strip | split: '.'

        if path_parts.size >= 2
          assign namespace = path_parts[0]
          assign key = path_parts[1]
          assign raw = product.metafields[namespace][key]
        endif
      endif
    -%}

    {%- comment -%}
      Captured rather than assigned so the value is always a string:
      a metafield drop renders per its own type here (rich text keeps
      its markup), and market-text can then scan it for tokens.
    {%- endcomment -%}
    {%- capture display -%}
      {%- if raw != blank -%}
        {%- if raw.type == 'boolean' -%}
          {%- if raw.value -%}{{ block_settings.boolean_true_text }}{%- endif -%}
        {%- elsif raw.type contains 'list.' -%}
          {{- raw.value | join: ', ' -}}
        {%- else -%}
          {{- raw -}}
        {%- endif -%}
      {%- endif -%}
    {%- endcapture -%}

    {%- liquid
      assign display = display | strip

      # Fall back to a variant option of the given name.
      if display == blank and row_label != blank and option_name != blank
        assign wanted = option_name | strip | downcase

        for product_option in product.options_with_values
          assign actual = product_option.name | strip | downcase

          if actual == wanted
            assign selected = product_option.selected_value
            if selected != blank
              assign display = selected
            endif
            break
          endif
        endfor
      endif
    -%}

    {%- if display != blank -%}
      <div class="mto-specs__row">
        <dt class="mto-specs__label">{% render 'market-text', text: row_label %}</dt>
        <dd class="mto-specs__value">{% render 'market-text', text: display %}</dd>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- assign rows_markup = rows_markup | strip -%}

{%- if rows_markup != blank -%}
  <div
    class="mto-specs spacing-style"
    style="{% render 'spacing-style', settings: block_settings %}"
    {{ block.shopify_attributes }}
  >
    {%- if block_settings.heading != blank -%}
      <{{ block_settings.heading_tag }} class="mto-specs__heading">
        {%- render 'market-text', text: block_settings.heading -%}
      </{{ block_settings.heading_tag }}>
    {%- endif -%}

    <dl class="mto-specs__list">
      {{ rows_markup }}
    </dl>
  </div>
{%- endif -%}

{% stylesheet %}
  .mto-specs {
    display: block;
  }

  .mto-specs__heading {
    margin: 0 0 10px;
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
  }

  .mto-specs__list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
  }

  .mto-specs__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2px;
    padding-block: 8px;
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .mto-specs__row:last-child {
    border-block-end: 0;
  }

  .mto-specs__label {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text, 0.7));
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .mto-specs__value {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .mto-specs__value > :first-child {
    margin-block-start: 0;
  }

  .mto-specs__value > :last-child {
    margin-block-end: 0;
  }

  @media screen and (min-width: 600px) {
    .mto-specs__row {
      grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
      gap: 12px;
      align-items: baseline;
    }
  }
{% endstylesheet %}

