{%- doc -%}
  "Made to order" badge plus an estimated delivery date range, for the
  made-to-order product template. Place it next to the product title.

  The range is rendered in Liquid by snippets/mto-delivery-range.liquid
  so it needs no JavaScript and crawlers see a real date. Because a
  cached page can serve yesterday's range, the inline script below
  recomputes it on load using the same business-day arithmetic. That
  script runs in the visitor's timezone while Liquid runs in the shop's,
  so the two can differ by a day near midnight; switch "Refresh the
  range in the browser" off to keep the shop-time value only.

  Deliberately says nothing about stock: this template is for items that
  are produced after the order is placed.
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
  assign range_id = 'MtoRange-' | append: block.id
-%}

<div
  class="mto-badge spacing-style"
  style="
    {% render 'spacing-style', settings: block_settings %}
    --mto-accent: {{ block_settings.accent_color }};
  "
  {{ block.shopify_attributes }}
>
  {%- if block_settings.show_badge and block_settings.badge_label != blank -%}
    <span class="mto-badge__pill">
      {%- if block_settings.icon != 'none' -%}
        <svg
          class="mto-badge__icon"
          viewBox="0 0 20 20"
          fill="currentColor"
          aria-hidden="true"
          focusable="false"
        >
          {%- render 'icon', icon: block_settings.icon -%}
        </svg>
      {%- endif -%}
      <span>{% render 'market-text', text: block_settings.badge_label %}</span>
    </span>
  {%- endif -%}

  {%- if block_settings.show_estimate -%}
    <p class="mto-badge__estimate">
      {%- if block_settings.estimate_prefix != blank -%}
        <span class="mto-badge__estimate-label">
          {%- render 'market-text', text: block_settings.estimate_prefix -%}
        </span>
      {%- endif -%}
      <span
        class="mto-badge__estimate-dates"
        id="{{ range_id }}"
        {% if block_settings.js_refresh %}
          data-production-min="{{ block_settings.production_min }}"
          data-production-max="{{ block_settings.production_max }}"
          data-shipping-min="{{ block_settings.shipping_min }}"
          data-shipping-max="{{ block_settings.shipping_max }}"
          data-cutoff-hour="{{ block_settings.cutoff_hour }}"
          data-locale="{{ request.locale.iso_code }}"
        {% endif %}
      >
        {%- render 'mto-delivery-range',
          production_min: block_settings.production_min,
          production_max: block_settings.production_max,
          shipping_min: block_settings.shipping_min,
          shipping_max: block_settings.shipping_max,
          cutoff_hour: block_settings.cutoff_hour
        -%}
      </span>
    </p>
  {%- endif -%}

  {%- if block_settings.note != blank -%}
    <p class="mto-badge__note">{% render 'market-text', text: block_settings.note %}</p>
  {%- endif -%}
</div>

{%- if block_settings.show_estimate and block_settings.js_refresh -%}
  <script>
    (function () {
      var el = document.getElementById({{ range_id | json }});
      if (!el || !el.dataset.productionMin) return;

      var data = el.dataset;
      var cutoff = parseInt(data.cutoffHour, 10) || 0;
      var now = new Date();
      var extra = cutoff > 0 && now.getHours() >= cutoff ? 1 : 0;

      var min = Math.max(
        (parseInt(data.productionMin, 10) || 0) + (parseInt(data.shippingMin, 10) || 0) + extra,
        1
      );
      var max = Math.max(
        (parseInt(data.productionMax, 10) || 0) + (parseInt(data.shippingMax, 10) || 0) + extra,
        min
      );

      var cursor = new Date(now.getTime());
      var counted = 0;
      var earliest = null;
      var latest = null;

      for (var i = 0; i < 200; i++) {
        cursor.setDate(cursor.getDate() + 1);
        var dayOfWeek = cursor.getDay();
        if (dayOfWeek === 0 || dayOfWeek === 6) continue;

        counted += 1;
        if (counted === min) earliest = new Date(cursor.getTime());
        if (counted >= max) {
          latest = new Date(cursor.getTime());
          break;
        }
      }

      if (!earliest || !latest) return;

      var options = { month: 'short', day: 'numeric' };
      var locale = data.locale || undefined;
      var from, to;

      try {
        from = earliest.toLocaleDateString(locale, options);
        to = latest.toLocaleDateString(locale, options);
      } catch (error) {
        return;
      }

      el.textContent = from === to ? from : from + ' – ' + to;
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .mto-badge {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .mto-badge__pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border: 1px solid var(--mto-accent, currentcolor);
    border-radius: 2px;
    color: var(--mto-accent, currentcolor);
    font-family: var(--font-body--family);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .mto-badge__icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .mto-badge__estimate,
  .mto-badge__note {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .mto-badge__estimate-label {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text, 0.7));
  }

  .mto-badge__estimate-dates {
    font-weight: 600;
    white-space: nowrap;
  }

  .mto-badge__note {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text, 0.7));
    font-size: 0.8125rem;
  }

  @media screen and (min-width: 750px) {
    .mto-badge {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px 12px;
    }

    .mto-badge__note {
      flex-basis: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Made to order badge",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Badge and estimated delivery window for items produced after the order is placed. Dates count business days (Mon-Fri) from today and skip weekends; public holidays are not modelled, so pad the shipping days if you need that cover."
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show the badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge text",
      "default": "Made to order",
      "info": "Market tokens such as [[origin]] are supported."
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Badge icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "stopwatch", "label": "Stopwatch" },
        { "value": "clipboard", "label": "Clipboard" },
        { "value": "check_box", "label": "Checkbox" },
        { "value": "truck", "label": "Truck" },
        { "value": "box", "label": "Box" },
        { "value": "ruler", "label": "Ruler" },
        { "value": "star", "label": "Star" },
        { "value": "heart", "label": "Heart" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "map_pin", "label": "Map pin" },
        { "value": "price_tag", "label": "Price tag" }
      ],
      "default": "stopwatch"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Badge colour",
      "default": "#E64A08"
    },
    {
      "type": "header",
      "content": "Estimated delivery"
    },
    {
      "type": "checkbox",
      "id": "show_estimate",
      "label": "Show the estimated delivery range",
      "default": true
    },
    {
      "type": "text",
      "id": "estimate_prefix",
      "label": "Label before the dates",
      "default": "Estimated delivery"
    },
    {
      "type": "range",
      "id": "production_min",
      "label": "Production days, low end",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 3,
      "unit": "d"
    },
    {
      "type": "range",
      "id": "production_max",
      "label": "Production days, high end",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 7,
      "unit": "d"
    },
    {
      "type": "range",
      "id": "shipping_min",
      "label": "Shipping days, low end",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 5,
      "unit": "d"
    },
    {
      "type": "range",
      "id": "shipping_max",
      "label": "Shipping days, high end",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 10,
      "unit": "d"
    },
    {
      "type": "range",
      "id": "cutoff_hour",
      "label": "Daily order cutoff",
      "min": 0,
      "max": 23,
      "step": 1,
      "default": 14,
      "info": "Orders placed at or after this hour (shop time) count from the next day. Set to 0 to ignore the cutoff."
    },
    {
      "type": "checkbox",
      "id": "js_refresh",
      "label": "Refresh the range in the browser",
      "default": true,
      "info": "Keeps the dates right on cached pages. Uses the visitor's timezone, which can differ from the shop's by a day near midnight."
    },
    {
      "type": "header",
      "content": "Supporting note"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note under the dates",
      "default": "Each piece is produced after you order, then shipped from [[origin]]."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Made to order badge",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
