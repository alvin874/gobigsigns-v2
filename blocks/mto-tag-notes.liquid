{%- doc -%}
  Tag-driven notes for wall art. Each of the four slots pairs a product
  tag with a line of copy; the note shows only when the product carries
  that tag, and the block disappears when none of them match.

  Defaults cover the wa- tags already used for collections:
    wa-hand-painted  each piece is unique
    wa-framed        frame included
    wa-sets          multi-panel, hanging guide included
    wa-large         oversized, freight or large-parcel shipping

  Tags are matched exactly, so "wa-large" does not match "wa-large-set".
  Both the tag and the copy are editable, so a new tag needs no code.
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
  assign product = closest.product
  assign slots = '1,2,3,4' | split: ','
-%}

{%- capture notes_markup -%}
  {%- for index in slots -%}
    {%- liquid
      assign tag_key = 'note_' | append: index | append: '_tag'
      assign text_key = 'note_' | append: index | append: '_text'
      assign icon_key = 'note_' | append: index | append: '_icon'

      assign note_tag = block_settings[tag_key] | strip
      assign note_text = block_settings[text_key]
      assign note_icon = block_settings[icon_key]
    -%}

    {%- if note_tag != blank and note_text != blank and product.tags contains note_tag -%}
      <li class="mto-tag-notes__item">
        {%- if note_icon != 'none' -%}
          <svg
            class="mto-tag-notes__icon"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            {%- render 'icon', icon: note_icon -%}
          </svg>
        {%- endif -%}
        <span class="mto-tag-notes__text">{% render 'market-text', text: note_text %}</span>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- assign notes_markup = notes_markup | strip -%}

{%- if notes_markup != blank -%}
  <div
    class="mto-tag-notes spacing-style"
    style="
      {% render 'spacing-style', settings: block_settings %}
      --mto-accent: {{ block_settings.accent_color }};
    "
    {{ block.shopify_attributes }}
  >
    {%- if block_settings.heading != blank -%}
      <{{ block_settings.heading_tag }} class="mto-tag-notes__heading">
        {%- render 'market-text', text: block_settings.heading -%}
      </{{ block_settings.heading_tag }}>
    {%- endif -%}

    <ul class="mto-tag-notes__list">
      {{ notes_markup }}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .mto-tag-notes {
    display: block;
  }

  .mto-tag-notes__heading {
    margin: 0 0 10px;
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
  }

  .mto-tag-notes__list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Flex rather than fixed grid columns: a note may or may not have an
     icon, and the text should take the remaining width either way. */
  .mto-tag-notes__item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .mto-tag-notes__icon {
    width: 16px;
    height: 16px;
    margin-block-start: 2px;
    flex-shrink: 0;
    color: var(--mto-accent, currentcolor);
  }

  .mto-tag-notes__text {
    flex: 1 1 auto;
    min-width: 0;
    font-size: 0.8125rem;
    line-height: 1.55;
  }
{% endstylesheet %}

