{% liquid
  assign faq_items = article.metafields.custom.faq.value
%}

{% if faq_items != blank %}
  <div class="article-faq" {{ block.shopify_attributes }}>
    {% if block.settings.heading != blank %}
      <h2 class="article-faq__heading">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="accordion accordion--plus border-style accordion--dividers">
      {% for item in faq_items %}
        {% capture accordion_row_children %}
          <details class="details" data-testid="accordion-details">
            <summary class="details__header">
              {{ item.question }}
              <span class="svg-wrapper icon-caret icon-animated">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
              <span class="svg-wrapper icon-plus">
                {{- 'icon-plus.svg' | inline_asset_content -}}
              </span>
            </summary>
            <div class="details-content">
              <p>{{ item.answer }}</p>
            </div>
          </details>
        {% endcapture %}
        {% render 'accordion-custom-component', children: accordion_row_children %}
      {% endfor %}
    </div>
  </div>

  {% render 'accordion-styles' %}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {% for item in faq_items %}
          {
            "@type": "Question",
            "name": {{ item.question | strip_html | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ item.answer | strip_html | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
  </script>
{% endif %}

{% stylesheet %}
  .article-faq {
    max-width: var(--normal-content-width);
    margin: 48px auto 0;
  }

  .article-faq__heading {
    margin: 0 0 20px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ accordion",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "paragraph",
      "content": "Reads a JSON metafield at custom.faq on the article (array of {question, answer}). Also outputs FAQPage schema. Renders nothing if that metafield is blank."
    }
  ],
  "presets": [
    {
      "name": "FAQ accordion",
      "category": "t:categories.blog_post"
    }
  ]
}
{% endschema %}
