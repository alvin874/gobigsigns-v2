{%- doc -%}
  Returns and cancellation notice for made-to-order items, with a link
  to the full policy page.

  Made to order narrows the returns window, so this states the terms on
  the product page rather than leaving the customer to find them at
  checkout. The link falls back to the shop's refund policy when no URL
  is set, and is dropped entirely when neither exists.
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings

  assign policy_url = block_settings.policy_url
  if policy_url == blank
    assign policy_url = shop.refund_policy.url
  endif
-%}

{%- if block_settings.body != blank or block_settings.heading != blank -%}
  <div
    class="mto-returns spacing-style"
    style="
      {% render 'spacing-style', settings: block_settings %}
      --mto-accent: {{ block_settings.accent_color }};
    "
    {{ block.shopify_attributes }}
  >
    {%- comment -%}
      The box padding lives on this inner element because .spacing-style
      already owns padding on the outer one.
    {%- endcomment -%}
    <div class="mto-returns__inner">
    {%- if block_settings.heading != blank -%}
      <{{ block_settings.heading_tag }} class="mto-returns__heading">
        {%- if block_settings.icon != 'none' -%}
          <svg
            class="mto-returns__icon"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            {%- render 'icon', icon: block_settings.icon -%}
          </svg>
        {%- endif -%}
        <span>{% render 'market-text', text: block_settings.heading %}</span>
      </{{ block_settings.heading_tag }}>
    {%- endif -%}

    {%- if block_settings.body != blank -%}
      <div class="mto-returns__body">
        {%- render 'market-text', text: block_settings.body -%}
      </div>
    {%- endif -%}

    {%- if policy_url != blank and block_settings.link_label != blank -%}
      <a class="mto-returns__link" href="{{ policy_url }}">
        {%- render 'market-text', text: block_settings.link_label -%}
      </a>
    {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .mto-returns {
    display: block;
  }

  .mto-returns__inner {
    padding: 14px 16px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
    border-radius: 2px;
  }

  .mto-returns__heading {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
    font-size: 0.875rem;
    letter-spacing: 0.02em;
  }

  .mto-returns__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: var(--mto-accent, currentcolor);
  }

  .mto-returns__body {
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .mto-returns__body > :first-child {
    margin-block-start: 0;
  }

  .mto-returns__body > :last-child {
    margin-block-end: 0;
  }

  .mto-returns__link {
    display: inline-block;
    margin-block-start: 8px;
    color: var(--mto-accent, currentcolor);
    font-size: 0.8125rem;
    text-underline-offset: 0.2em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Made-to-order returns",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "States the returns and cancellation terms for items produced after the order is placed. Keep this in step with your published policy."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Returns on made-to-order art"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "p", "label": "Plain text" }
      ],
      "default": "h3"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "return", "label": "Return" },
        { "value": "error", "label": "Alert" },
        { "value": "lock", "label": "Lock" },
        { "value": "clipboard", "label": "Clipboard" },
        { "value": "check_box", "label": "Checkbox" },
        { "value": "question_mark", "label": "Question mark" }
      ],
      "default": "return"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Notice",
      "default": "<p>Because each piece is made for your order, we cannot accept returns or exchanges once production has started. Orders can be cancelled free of charge within 24 hours of ordering. Damaged or defective pieces are replaced free: report them within 48 hours of delivery with photos of the item and the packaging.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link text",
      "default": "Read the full returns policy"
    },
    {
      "type": "url",
      "id": "policy_url",
      "label": "Link",
      "info": "Leave blank to use the shop's refund policy page."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "#E64A08"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Made-to-order returns",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
