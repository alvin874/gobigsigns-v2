{%- doc -%}
  Hero section that pairs editable text/button content with a live
  2x2 grid of real product photos pulled from a collection, instead
  of static image_picker media. Requires no image uploads and stays
  current automatically as the catalog changes.
{%- enddoc -%}

{% liquid
  assign hero_collection = section.settings.collection
  if hero_collection == blank
    assign hero_collection = collections.all
  endif
%}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div
  class="gb-hero-live section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="background: {{ section.settings.background_color }}; padding-block-start: {{ section.settings.padding-block-start }}px; padding-block-end: {{ section.settings.padding-block-end }}px;"
  {{ section.shopify_attributes }}
>
  <div class="gb-hero-live__inner">
    <div class="gb-hero-live__content">
      {% content_for 'blocks' %}
    </div>
    <div class="gb-hero-live__grid">
      {% for product in hero_collection.products limit: 4 %}
        <a href="{{ product.url }}" class="gb-hero-live__tile">
          {% render 'image', image: product.featured_image, height: 500, class: 'gb-hero-live__img', alt_text_fallback: product.title %}
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .gb-hero-live__inner {
    display: flex;
    align-items: stretch;
    flex-wrap: wrap;
    gap: 0;
  }

  .gb-hero-live__content {
    flex: 1 1 420px;
    min-width: 300px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
    padding: 64px;
  }

  .gb-hero-live__grid {
    flex: 1 1 400px;
    min-width: 300px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
  }

  .gb-hero-live__tile {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--color-background-secondary, #f8f7f5);
  }

  /* Fill the grid cleanly whatever the collection holds: a lone tile,
     or a third tile with no partner, spans the full width instead of
     leaving a gap. */
  .gb-hero-live__tile:nth-child(1):last-child,
  .gb-hero-live__tile:nth-child(3):last-child {
    grid-column: span 2;
    aspect-ratio: 2 / 1;
  }

  .gb-hero-live__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .gb-hero-live__content {
      padding: 40px 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero (live products)",
  "tag": "section",
  "class": "section",
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the first 4 products from the chosen collection instead of a static hero image. Leave blank to use All Products."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to feature"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "full-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#0C1E3C"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Hero (live products)",
      "category": "t:categories.hero",
      "blocks": {
        "eyebrow": { "type": "text" },
        "heading": { "type": "text" },
        "button": { "type": "button" }
      },
      "block_order": ["eyebrow", "heading", "button"]
    }
  ]
}
{% endschema %}
