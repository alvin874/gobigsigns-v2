<script>
  function gbFaqToggle(btn) {
    const item = btn.closest('.gbfaq-item');
    const isOpen = item.classList.contains('open');
    item.classList.toggle('open', !isOpen);
    btn.setAttribute('aria-expanded', !isOpen);
    btn.querySelector('.gbfaq-item__icon').textContent = isOpen ? '+' : '−';
  }

  function gbFaqCat(btn, cat) {
    document.querySelectorAll('.gbfaq-nav__btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('.gbfaq-group').forEach(g => {
      g.style.display = (g.dataset.cat === cat) ? 'block' : 'none';
    });
    document.querySelector('.gbfaq-group[data-cat="' + cat + '"]')
      ?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // Show all groups by default (no filtering on load)
  document.querySelectorAll('.gbfaq-group').forEach(g => g.style.display = 'block');
</script>

