{%- doc -%}
  Collection hero and expandable description, ported from the v1 theme's
  templates/collection.liquid.
{%- enddoc -%}

<div class="gbcoll-hero">
  <div class="gbcoll-hero__bg"></div>
  {%- if collection.image -%}
    <img
      class="gbcoll-hero__img"
      src="{{ collection.image | image_url: width: 1600 }}"
      alt="{{ collection.image.alt | escape }}"
      loading="eager"
      width="1600"
      height="{{ 1600 | divided_by: collection.image.aspect_ratio | round }}"
    >
  {%- endif -%}
  <div class="gbcoll-hero__grid"></div>

  <div class="gbcoll-hero__crumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span class="gbcoll-hero__crumb-sep">/</span>
    <a href="{{ routes.collections_url }}">Collections</a>
    <span class="gbcoll-hero__crumb-sep">/</span>
    <span>{{ collection.title }}</span>
  </div>

  <div class="gbcoll-hero__label">{{ collection.title }}</div>
  <h1 class="gbcoll-hero__title">{{ collection.title }}</h1>

  <div class="gbcoll-hero__meta">
    <div class="gbcoll-hero__count">
      <strong>{{ collection.products_count }}</strong> Products
    </div>
  </div>
</div>

{%- if collection.description != blank -%}
  <div class="gbcoll-desc-bar">
    <div class="gbcoll-desc-bar__inner">
      <div class="gbcoll-desc-bar__text" id="gbCollDesc">
        <div class="gbcoll-desc-preview">{{ collection.description }}</div>
      </div>
      <button class="gbcoll-desc-bar__toggle" id="gbDescToggle" type="button" onclick="gbToggleDesc()">
        Read More <span class="gbcoll-desc-arrow">↓</span>
      </button>
    </div>
  </div>

  <script>
    function gbToggleDesc() {
      var desc = document.getElementById('gbCollDesc');
      var btn = document.getElementById('gbDescToggle');
      var isExpanded = desc.classList.toggle('expanded');
      btn.innerHTML = isExpanded
        ? 'Show Less <span class="gbcoll-desc-arrow"></span>'
        : 'Read More <span class="gbcoll-desc-arrow">↓</span>';
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .gbcoll-hero,
  .gbcoll-desc-bar {
    --gbc-navy: #0c1e3c;
    --gbc-orange: #e64a08;
    --gbc-text-mid: #4a4a60;
    --gbc-border: #e2ddd6;
    --gbc-warm: #f8f7f5;
    --gbc-display: var(--font-heading--family);
    --gbc-ui: var(--font-body--family);
  }

  .gbcoll-hero {
    position: relative;
    overflow: hidden;
    min-height: 320px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 48px 52px;
    background: var(--gbc-navy);
  }

  .gbcoll-hero__bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 80% at 80% 50%, rgb(230 74 8 / 12%) 0%, transparent 65%),
      radial-gradient(ellipse 50% 70% at 10% 80%, rgb(200 164 52 / 5%) 0%, transparent 55%),
      var(--gbc-navy);
  }

  .gbcoll-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.18;
  }

  .gbcoll-hero__grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgb(255 255 255 / 4%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 4%) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 90% 90% at 50% 100%, black 30%, transparent 100%);
  }

  .gbcoll-hero__crumb {
    position: relative;
    font-family: var(--gbc-ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: rgb(255 255 255 / 35%);
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
  }

  .gbcoll-hero__crumb a {
    color: rgb(255 255 255 / 35%);
    text-decoration: none;
    transition: color 0.2s;
  }

  .gbcoll-hero__crumb a:hover {
    color: var(--gbc-orange);
  }

  .gbcoll-hero__crumb-sep {
    opacity: 0.4;
  }

  .gbcoll-hero__label {
    position: relative;
    font-family: var(--gbc-ui);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--gbc-orange);
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    text-transform: uppercase;
  }

  .gbcoll-hero__label::before {
    content: '';
    width: 24px;
    height: 1px;
    background: var(--gbc-orange);
    flex-shrink: 0;
  }

  .gbcoll-hero__title {
    position: relative;
    font-family: var(--gbc-display);
    font-weight: 500;
    font-size: clamp(52px, 7vw, 112px);
    line-height: 0.9;
    letter-spacing: 0.02em;
    color: #fff;
    margin: 0;
  }

  .gbcoll-hero__meta {
    position: absolute;
    bottom: 52px;
    right: 48px;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .gbcoll-hero__count {
    font-family: var(--gbc-ui);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: rgb(255 255 255 / 40%);
  }

  .gbcoll-hero__count strong {
    color: #fff;
    font-size: 20px;
    font-family: var(--gbc-display);
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  .gbcoll-desc-bar {
    background: var(--gbc-warm);
    border-bottom: 1px solid var(--gbc-border);
    padding: 0 48px;
  }

  .gbcoll-desc-bar__inner {
    max-width: 860px;
    padding: 28px 0;
  }

  .gbcoll-desc-bar__text {
    font-size: 15px;
    color: var(--gbc-text-mid);
    line-height: 1.8;
    position: relative;
  }

  .gbcoll-desc-bar__text .gbcoll-desc-preview {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .gbcoll-desc-bar__text.expanded .gbcoll-desc-preview {
    display: block;
    -webkit-line-clamp: unset;
  }

  .gbcoll-desc-bar__toggle {
    margin-top: 10px;
    font-family: var(--gbc-ui);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--gbc-orange);
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0;
    transition: gap 0.2s;
  }

  .gbcoll-desc-bar__toggle:hover {
    gap: 10px;
  }

  .gbcoll-desc-arrow {
    display: inline-block;
  }

  @media screen and (max-width: 1024px) {
    .gbcoll-hero,
    .gbcoll-desc-bar {
      padding-left: 24px;
      padding-right: 24px;
    }

    .gbcoll-hero__meta {
      right: 24px;
    }
  }

  @media screen and (max-width: 768px) {
    .gbcoll-hero {
      min-height: 240px;
      padding-bottom: 36px;
    }

    .gbcoll-hero__meta {
      position: static;
      margin-top: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection hero",
  "tag": "div",
  "class": "collection-hero",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": []
}
{% endschema %}
