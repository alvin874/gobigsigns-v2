{%- doc -%}
  Adds published collections inside Catalog's mega menu or mobile child list.
  Configured Catalog links are retained; nested duplicate URLs are skipped.
  Does not render standalone top-level navigation links.

  @param {linklist} menu - The Catalog parent link.
  @param {string} variant - mega or drawer-child.
{%- enddoc -%}
{%- liquid
  assign collection_handles = 'custom-roll-labels|print-packaging|replacement-graphics' | split: '|'
  assign collection_titles = 'Labels & Stickers|Print & Packaging|Replacement Graphics' | split: '|'
-%}
{%- for collection_handle in collection_handles -%}
  {%- liquid
    assign target_collection = collections[collection_handle]
    assign already_linked = false
    for configured_link in menu.links
      if configured_link.url == target_collection.url
        assign already_linked = true
      endif
      for child_link in configured_link.links
        if child_link.url == target_collection.url
          assign already_linked = true
        endif
        for grandchild_link in child_link.links
          if grandchild_link.url == target_collection.url
            assign already_linked = true
          endif
        endfor
      endfor
    endfor
    assign link_title = collection_titles[forloop.index0]
  -%}
  {%- if target_collection != blank and already_linked == false -%}
    {%- case variant -%}
      {%- when 'drawer-child' -%}
        <li class="menu-drawer__list-item" style="--menu-drawer-animation-index: {{ menu.links.size | plus: forloop.index }};" data-catalog-collection-link>
          <a
            href="{{ target_collection.url }}"
            class="menu-drawer__menu-item menu-drawer__menu-item--child menu-drawer__animated-element"
            {% if request.path == target_collection.url %}aria-current="page"{% endif %}
          >
            <span class="menu-drawer__menu-item-text wrap-text">{{ link_title | escape }}</span>
          </a>
        </li>
      {%- when 'mega' -%}
        <li data-catalog-collection-link>
          <a href="{{ target_collection.url }}" class="mega-menu__link" {% if request.path == target_collection.url %}aria-current="page"{% endif %}>
            <span class="wrap-text">{{ link_title | escape }}</span>
          </a>
        </li>
    {%- endcase -%}
  {%- endif -%}
{%- endfor -%}
